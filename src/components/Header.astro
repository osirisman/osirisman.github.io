---
// 상단 메뉴입니다. 포트폴리오 메뉴는 영상이 충분할 때만 보입니다.
import { site } from '../data/site';

interface Props {
  showPortfolio: boolean;
}

const { showPortfolio } = Astro.props;

// 최상단 메뉴에는 포트폴리오를 두지 않습니다. 모바일 메뉴에만 포트폴리오가 보입니다.
const navLinks = [
  { label: '회사소개', href: '#about' },
  { label: '서비스', href: '#services' },
];
const mobileLinks = [
  ...navLinks,
  ...(showPortfolio ? [{ label: '포트폴리오', href: '#portfolio' }] : []),
];
const mailHref = `mailto:${site.email}`;
---

<header class="site-head">
  <div class="bar">
    <nav aria-label="주 메뉴">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a class="logo" href="#">{site.brandName}.</a>
    <div class="r">
      <a class="pill sm y" href={mailHref}>촬영 문의하기</a>
    </div>
    <button class="menu-btn" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="m-nav">
      <span class="burger"><i></i><i></i><i></i></span>
    </button>
  </div>

  <nav class="m-nav" id="m-nav" aria-label="모바일 메뉴">
    {mobileLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="pill y" href={mailHref}>촬영 문의하기</a>
  </nav>
</header>
