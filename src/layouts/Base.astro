---
// 모든 페이지가 공통으로 쓰는 틀입니다. <head>, 메타 정보, 헤더, 푸터, 문의 창을 한 번에 관리합니다.
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/pages.css';
import { site } from '../data/site';
import ContactDialog from '../components/ContactDialog.astro';

interface Props {
  title: string;
  description?: string;
  // 홈처럼 레이어 문의 창을 쓰는 페이지는 true, /contact처럼 폼이 본문에 있는 페이지는 false입니다.
  contactDialog?: boolean;
}

const { title, description = site.description, contactDialog = true } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600;700&family=Noto+Sans+KR:wght@400;500;700&display=swap"
    />
    <!-- 서비스 전환, 모바일 메뉴, 문의 폼 전송과 문의 창을 위한 작은 스크립트입니다. -->
    <script>
      import '../scripts/main.ts';
      import '../scripts/contact-form.ts';
      import '../scripts/contact-dialog.ts';
    </script>
  </head>
  <body>
    <slot name="header" />
    <slot />
    <slot name="footer" />
    {contactDialog && <ContactDialog />}
  </body>
</html>
