---
// 1:1 촬영 문의 페이지입니다. 홈에서 문의 창을 열 수 없을 때(JavaScript가 꺼진 경우 등)와 직접 주소 접속용입니다.
// 전송은 Web3Forms로 합니다(src/components/ContactForm.astro, src/scripts/contact-form.ts).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
import { portfolio, MIN_PORTFOLIO_COUNT } from '../data/portfolio';

const showPortfolio = portfolio.length >= MIN_PORTFOLIO_COUNT;
---

<Base title={`1:1 촬영 문의 | ${site.brandName}`} description="드론 항공 촬영, 건축·부동산, 기업 시설, 행사·공연 영상 촬영을 1:1로 문의하세요." contactDialog={false}>
  <Header slot="header" showPortfolio={showPortfolio} />

  <main>
    <section class="page-head">
      <div class="in">
        <h1>1:1 촬영 문의</h1>
        <p class="page-lead">촬영 목적, 장소, 희망 일정을 알려 주시면 촬영 가능 여부와 진행 방법을 빠른 시일 안에 안내해 드립니다.</p>
      </div>
    </section>

    <section class="form-wrap">
      <div class="in">
        <ContactForm />
      </div>
    </section>
  </main>

  <Footer slot="footer" showPortfolio={showPortfolio} />
</Base>
